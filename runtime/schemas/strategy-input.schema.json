{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nfb:protocol:2.1.0:strategy-input.schema",
  "title": "strategy-input",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "2.1.0"
    },
    "message_type": {
      "const": "strategy_input"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of_ms": {
      "type": "integer",
      "minimum": 0
    },
    "ledger_version": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "enum": [
        "shadow",
        "paper",
        "live"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy_id": {
          "const": "nfb.strategy.20261108.rc2"
        },
        "profile_sha256": {
          "const": "7fd3f61359620109a3462f7afcf50f13d0cb3381aad65f7205b01dea93ecf7f5"
        },
        "engine_source_sha256": {
          "const": "58b3aa64d6315497037de9adac4aaff1d50f382abe2cda8eccdc2a3d179d9d51"
        }
      },
      "required": [
        "strategy_id",
        "profile_sha256",
        "engine_source_sha256"
      ]
    },
    "portfolio": {
      "type": "object",
      "properties": {
        "initial_capital_usdt": {
          "const": "10000000"
        },
        "strategy_marked_pnl_usdt": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "used_entry_capital_usdt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "account_a_free_usdt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "account_b_free_usdt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "internal_transfers_allowed": {
          "type": "boolean"
        },
        "unsettled_transfer_usdt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "snapshot_received_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_entry_capital_usdt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "account_b_wallet_usdt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "account_b_equity_usdt": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "account_b_initial_margin_1x_usdt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "account_b_position_notional_usdt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "account_b_transferable_usdt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "risk_state": {
          "enum": [
            "NORMAL",
            "PAUSE_NEW",
            "EXIT_ALL",
            "RECONCILE"
