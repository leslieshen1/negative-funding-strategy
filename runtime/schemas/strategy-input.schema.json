        "initial_capital_usdt",
        "strategy_marked_pnl_usdt",
        "used_entry_capital_usdt",
        "account_a_free_usdt",
        "account_b_free_usdt",
        "internal_transfers_allowed",
        "unsettled_transfer_usdt",
        "snapshot_received_at_ms",
        "reserved_entry_capital_usdt",
        "account_b_wallet_usdt",
        "account_b_equity_usdt",
        "account_b_initial_margin_1x_usdt",
        "account_b_position_notional_usdt",
        "account_b_transferable_usdt",
        "risk_state"
      ],
      "additionalProperties": false
