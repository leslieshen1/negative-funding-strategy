              "instrument_id",
              "token",
              "spot_symbol",
              "perp_symbol",
              "tokens_per_perp_quantity",
              "spot_qty_step_token",
              "perp_qty_step_exchange",
              "spot_min_qty_token",
              "perp_min_qty_exchange",
              "spot_min_notional_usdt",
              "perp_min_notional_usdt"
            ],
            "additionalProperties": false
          },
          "position": {
            "type": "object",
            "properties": {
              "strategy_sold_spot_qty_token": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "perp_long_qty_exchange": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "perp_long_qty_token": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "exit_locked": {
                "type": "boolean"
              },
              "episode_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "entry_cost_usdt": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "reserved_entry_cost_usdt": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "reserved_add_qty_token": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "episode_coin_return_due_token": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
