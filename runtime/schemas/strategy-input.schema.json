              "shared_slice_budget_remaining_usdt": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "spot_quote_volume_capacity_window_usdt": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "perp_quote_volume_capacity_window_usdt": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "depth_0_2pct_usdt": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "depth_1pct_usdt": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "depth_source": {
                "enum": [
                  "observed",
                  "volume_proxy",
                  "unavailable"
                ]
              },
              "status": {
                "enum": [
                  "OK",
                  "INCOMPLETE"
                ]
              },
              "quotes_received_at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "completed_inputs_received_at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "spot_bid_usdt_per_token": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "spot_ask_usdt_per_token": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "perp_bid_usdt_per_token": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "perp_ask_usdt_per_token": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "capacity_window_start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "capacity_window_complete": {
                "type": "boolean"
              },
              "shared_slice_used_usdt": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "shared_slice_reserved_usdt": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "settlement_coverage_start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "settlements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "funding_time_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "received_at_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "raw_rate": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    "interval_hours": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    }
                  },
                  "required": [
                    "funding_time_ms",
                    "received_at_ms",
                    "raw_rate",
                    "interval_hours"
                  ]
                }
              }
            },
            "required": [
              "observed_at_ms",
              "previous_bar_end_ms",
              "spot_close_usdt_per_token",
              "perp_close_usdt_per_token",
              "settled_r8",
              "settled_r8_source",
              "latest_settlement_time_ms",
              "latest_settlement_received_at_ms",
              "latest_raw_rate",
              "latest_interval_hours",
              "raw_settled_sum_24h",
              "settlement_history_complete",
              "open_interest_usdt",
              "trailing_24h_paired_quote_volume_usdt",
              "capacity_window_end_ms",
              "capacity_view",
              "spot_quote_volume_capacity_window_usdt",
              "perp_quote_volume_capacity_window_usdt",
              "depth_0_2pct_usdt",
              "depth_1pct_usdt",
              "depth_source",
              "status",
              "quotes_received_at_ms",
              "completed_inputs_received_at_ms",
              "spot_bid_usdt_per_token",
              "spot_ask_usdt_per_token",
              "perp_bid_usdt_per_token",
              "perp_ask_usdt_per_token",
              "capacity_window_start_ms",
              "capacity_window_complete",
              "shared_slice_used_usdt",
              "shared_slice_reserved_usdt",
              "settlement_coverage_start_ms",
              "settlements"
            ],
            "additionalProperties": false
          },
          "limits": {
            "type": "object",
            "properties": {
              "inventory_cap_qty_token": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "inventory_available_qty_token": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "per_coin_cap_usdt": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "max_position_notional_from_oi_usdt": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "max_position_notional_from_volume_usdt": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            },
            "required": [
              "inventory_cap_qty_token",
              "inventory_available_qty_token"
