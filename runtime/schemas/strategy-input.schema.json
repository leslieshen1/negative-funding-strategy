            "additionalProperties": false
          },
          "risk": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pause_new": {
                "type": "boolean"
              },
              "force_exit": {
                "type": "boolean"
              },
              "notice_received_at_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "pause_new",
              "force_exit",
              "notice_received_at_ms",
              "reason_codes"
            ]
          },
          "model_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bar_end_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "received_at_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "spot_close_usdt_per_token": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "perp_close_usdt_per_token": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "oi_usdt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "availability_source": {
                  "enum": [
                    "observed",
                    "research_hourly_receive_proxy"
                  ]
                }
              },
              "required": [
                "bar_end_ms",
                "received_at_ms",
                "spot_close_usdt_per_token",
                "perp_close_usdt_per_token",
                "oi_usdt",
                "availability_source"
              ]
            }
          }
        },
        "required": [
          "instrument",
          "position",
          "market",
          "limits",
          "risk"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol_version",
    "message_type",
    "request_id",
    "as_of_ms",
    "ledger_version",
    "mode",
    "model",
    "portfolio",
    "instruments"
  ],
  "additionalProperties": false
}
