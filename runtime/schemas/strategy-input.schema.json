              "previous_bar_end_ms": {
                "type": "integer",
                "minimum": 0
              },
              "spot_close_usdt_per_token": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "perp_close_usdt_per_token": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "settled_r8": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "settled_r8_source": {
                "enum": [
                  "latest_settled",
                  "archived_reference",
                  "unknown"
                ]
              },
              "latest_settlement_time_ms": {
                "type": "integer",
                "minimum": 0
              },
              "latest_settlement_received_at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "latest_raw_rate": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latest_interval_hours": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "raw_settled_sum_24h": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "settlement_history_complete": {
                "type": "boolean"
              },
              "open_interest_usdt": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trailing_24h_paired_quote_volume_usdt": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "capacity_window_end_ms": {
                "type": "integer",
                "minimum": 0
              },
              "capacity_view": {
                "const": "causal_online"
