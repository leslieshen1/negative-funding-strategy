{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "nfb.treasury-input.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of_ms": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_received_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "ledger_version": {
      "type": "integer",
      "minimum": 0
    },
    "source_mode": {
      "enum": [
        "synthetic",
        "observed"
      ]
    },
    "account_mode": {
      "enum": [
        "USDT_SINGLE",
        "MULTI_ASSETS",
        "PM",
        "PM_PRO"
      ]
    },
    "account_kind": {
      "enum": [
        "MASTER",
        "REGULAR_SUB"
      ]
    },
    "account_a": {
      "type": "object",
      "properties": {
        "settled_usdt": {
          "type": "string",
          "pattern": "-?(0|[1-9][0-9]*)(\\.[0-9]+)?"
        },
        "reserved_usdt": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
        }
      },
      "required": [
        "settled_usdt",
        "reserved_usdt"
      ],
      "additionalProperties": false
    },
    "account_b": {
      "type": "object",
      "properties": {
        "settled_usdt": {
          "type": "string",
          "pattern": "-?(0|[1-9][0-9]*)(\\.[0-9]+)?"
        },
        "reserved_usdt": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
        },
        "unrealized_pnl_usdt": {
          "type": "string",
          "pattern": "-?(0|[1-9][0-9]*)(\\.[0-9]+)?"
        },
        "other_liabilities_usdt": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
        },
        "position_notional_usdt": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
        },
        "exchange_adjusted_equity_usdt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "-?(0|[1-9][0-9]*)(\\.[0-9]+)?"
            },
            {
              "type": "null"
            }
          ]
        },
        "exchange_max_withdraw_usdt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "-?(0|[1-9][0-9]*)(\\.[0-9]+)?"
            },
            {
              "type": "null"
            }
          ]
        },
        "exchange_available_for_new_initial_margin_usdt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "-?(0|[1-9][0-9]*)(\\.[0-9]+)?"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "settled_usdt",
        "reserved_usdt",
        "unrealized_pnl_usdt",
        "other_liabilities_usdt",
        "position_notional_usdt",
        "exchange_adjusted_equity_usdt",
        "exchange_max_withdraw_usdt",
        "exchange_available_for_new_initial_margin_usdt"
      ],
      "additionalProperties": false
    },
    "yield_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "enum": [
              "A",
              "B"
            ]
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "string",
            "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
          },
          "nav_usdt_per_unit": {
            "type": "string",
            "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
          },
          "collateral_ratio": {
            "type": "string",
            "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
          },
          "tiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ceiling_usdt": {
                  "type": "string",
                  "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
                },
                "collateral_ratio": {
                  "type": "string",
                  "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
                }
              },
              "required": [
                "ceiling_usdt",
                "collateral_ratio"
              ],
              "additionalProperties": false
            }
          },
          "status": {
            "enum": [
              "SETTLED",
              "REDEEMING",
              "PENDING"
            ]
          },
          "eligibility_verified": {
            "type": "boolean"
          },
          "observed_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "valid_until_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "account",
          "asset",
          "quantity",
          "nav_usdt_per_unit",
          "collateral_ratio",
          "tiers",
          "status",
          "eligibility_verified",
          "observed_at_ms",
          "valid_until_ms"
        ],
        "additionalProperties": false
      }
    },
    "pending_redemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "account": {
            "enum": [
              "A",
              "B"
            ]
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "amount_usdt": {
            "type": "string",
            "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
          }
        },
        "required": [
          "request_id",
          "account",
          "asset",
          "amount_usdt"
        ],
        "additionalProperties": false
      }
    },
    "pending_transfers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "from_account": {
            "enum": [
              "A",
              "B"
            ]
          },
          "to_account": {
            "enum": [
              "A",
              "B"
            ]
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
          }
        },
        "required": [
          "request_id",
          "from_account",
          "to_account",
          "asset",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "sold_spot_qty_token": {
            "type": "string",
            "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
          },
          "perp_long_qty_token": {
            "type": "string",
            "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
          },
          "borrowed_qty_token": {
            "type": "string",
            "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
          },
          "provider_confirmed_return_qty_token": {
            "type": "string",
            "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
          },
          "spot_ask_usdt_per_token": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "-?(0|[1-9][0-9]*)(\\.[0-9]+)?"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit_locked": {
            "type": "boolean"
          },
          "risk_events": {
            "type": "array",
            "items": {
              "enum": [
                "BORROW_RECALL",
                "ADL",
                "LIQUIDATION",
                "DELISTING",
                "TRADING_HALT"
              ]
            }
          },
          "rehypothecation_authorized": {
            "type": "boolean"
          }
        },
        "required": [
          "instrument_id",
          "sold_spot_qty_token",
          "perp_long_qty_token",
          "borrowed_qty_token",
          "provider_confirmed_return_qty_token",
          "spot_ask_usdt_per_token",
          "exit_locked",
          "risk_events",
          "rehypothecation_authorized"
        ],
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "spot_fee_rate": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
        },
        "a_buyback_stress_multiple": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
        },
        "b_collateral_buffer_usdt": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
        }
      },
      "required": [
        "spot_fee_rate",
        "a_buyback_stress_multiple",
        "b_collateral_buffer_usdt"
      ],
      "additionalProperties": false
    },
    "rc2_new_exposure_budget_usdt": {
      "type": "string",
      "pattern": "(0|[1-9][0-9]*)(\\.[0-9]+)?"
    },
    "subaccount_conversion_route_verified": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "as_of_ms",
    "snapshot_received_at_ms",
    "ledger_version",
    "source_mode",
    "account_mode",
    "account_kind",
    "account_a",
    "account_b",
    "yield_assets",
    "pending_redemptions",
    "pending_transfers",
    "instruments",
    "policy",
    "rc2_new_exposure_budget_usdt",
    "subaccount_conversion_route_verified"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nfb:treasury-input:v1"
}
